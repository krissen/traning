# Path to external training data directory.
# Copy this file to .Renviron and set the path for your machine.
TRANING_DATA=/Users/YOURNAME/Documents/traning-data

# Garmin Connect credentials (used by python/garmin_fetch.py).
# Optional — you'll be prompted if not set.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Physiological parameters (used by HR zone analysis).
# BIRTH_YEAR — enables time-varying HRmax via Tanaka formula (208 - 0.7 * age)
# HR_MAX — fixed HRmax override (ignores age decline; use for lab-tested value)
#BIRTH_YEAR=1980
#HR_MAX=

# Health Auto Export TCP server (used by `traning fetch health`).
# Set to the hostname or IP of the device running HAE.
#HAE_HOST=
#HAE_PORT=9000

# Receiver (used by `traning doctor run --check freshness`).
# Without these the freshness check cannot query the receiver and can
# only judge the age of this machine's copy of the data — which on a
# dev box is the age of the last `git pull`, not the health of the
# pipeline. Point them at the receiver over Tailscale and copy the key
# from /etc/traning/env on kailash to get the real verdict.
#TRANING_RECEIVER_HOST=100.93.126.68
#TRANING_RECEIVER_PORT=8421
#TRANING_API_KEY=

# Output defaults (all optional).
# TRANING_OUTPUT_DIR — base directory for saved plots/tables (default: $TRANING_DATA/output)
# TRANING_PLOT_FORMAT — default plot format: pdf, png (default: pdf)
# TRANING_TABLE_FORMAT — default table format: csv, json, jsonl, xlsx (default: csv)
# TRANING_OPEN — open files after saving: true/false (default: true)
#TRANING_OUTPUT_DIR=
#TRANING_PLOT_FORMAT=pdf
#TRANING_TABLE_FORMAT=csv
#TRANING_OPEN=true
