# tRäning server environment — copy to /etc/traning/env on kailash
# Also keep a local copy as traning-env.local (gitignored) with real values

# Required
TRANING_DATA=/home/krisse/dokument/traning-data
TRANING_API_KEY=<generate: openssl rand -hex 32>

# Garmin Connect credentials
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Home Assistant (for notifications)
HA_URL=http://localhost:8123
HA_TOKEN=

# Optional
TRANING_OPEN=false

# Apple Health export tree for `traning device scan --source healthkit`.
# Dated subdirectories (<YYYY-MM-DD>/apple_health_export/export.xml),
# unpacked — not part of $TRANING_DATA, and not backed up by the data
# repo's git history; restic covers it separately.
#TRANING_HEALTHKIT_EXPORTS=/home/krisse/data/apple_health_export

# Bind policy on kailash. The web UI stays on loopback behind Caddy, while
# machine-to-machine services listen only on Tailscale by default.
TRANING_RECEIVER_HOST=100.93.126.68
TRANING_RECEIVER_PORT=8421
TRANING_SHINY_HOST=127.0.0.1
TRANING_SHINY_PORT=8423
VAYU_HOST=100.93.126.68
VAYU_PORT=8422
